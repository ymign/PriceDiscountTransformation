{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Pricing": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": false,
    "Title": "Pricing RuleCenter API",
    "Version": "v1"
  },
  "Pricing": {
    "ConfirmExpireMinutes": 30,
    "ExpireCleanupIntervalSeconds": 300,
    "CacheVersionSyncIntervalSeconds": 3,
    "HttpTimeoutSeconds": 10,
    "MaxRetryCount": 3,
    "EnableAuthorityPriceCheck": true
  },
  "HealthChecks": {
    "ThirdPartyServices": []
  }
}
